1755820283300:package ER.Ericson.betterteams.utils;\n\nimport ER.Ericson.betterteams.BetterTeamsPlugin;\nimport ER.Ericson.betterteams.managers.PlayerData;\nimport ER.Ericson.betterteams.managers.TeamData;\nimport org.bukkit.Location;\nimport org.bukkit.configuration.file.FileConfiguration;\nimport org.bukkit.configuration.file.YamlConfiguration;\n\nimport java.io.File;\nimport java.io.IOException;\nimport java.util.*;\n\n/**\n * FileUtils: gestión de archivos YAML para equipos\n * - Guarda y carga miembros, líderes, invites y home\n */\npublic class FileUtils {\n\n    private final BetterTeamsPlugin plugin;\n    private final File teamsFile;\n    private FileConfiguration teamsConfig;\n\n    public FileUtils(BetterTeamsPlugin plugin) {\n        this.plugin = plugin;\n        this.teamsFile = new File(plugin.getDataFolder(), "teams.yml");\n\n        if (!teamsFile.exists()) {\n            plugin.getDataFolder().mkdirs();\n            try {\n                teamsFile.createNewFile();\n            } catch (IOException e) {\n                e.printStackTrace();\n            }\n        }\n        teamsConfig = YamlConfiguration.loadConfiguration(teamsFile);\n    }\n\n    public FileConfiguration getConfig() {\n        return teamsConfig;\n    }\n\n    public void save() {\n        try {\n            teamsConfig.save(teamsFile);\n        } catch (IOException e) {\n            e.printStackTrace();\n        }\n    }\n\n    public void reload() {\n        teamsConfig = YamlConfiguration.loadConfiguration(teamsFile);\n    }\n\n    // ========================\n    // Guardar equipos\n    // ========================\n    public void saveTeams(Map<String, TeamData> teams) {\n        teamsConfig.set("teams", null); // Limpiar antes\n        for (TeamData team : teams.values()) {\n            String path = "teams." + team.getName();\n\n            // Guardar home\n            if (team.getHome() != null) {\n                Location loc = team.getHome();\n                teamsConfig.set(path + ".home.world", loc.getWorld().getName());\n                teamsConfig.set(path + ".home.x", loc.getX());\n                teamsConfig.set(path + ".home.y", loc.getY());\n                teamsConfig.set(path + ".home.z", loc.getZ());\n            }\n\n            // Guardar líder\n            PlayerData leader = team.getLeader();\n            if (leader != null) {\n                teamsConfig.set(path + ".leader", leader.getUuid().toString());\n            }\n\n            // Guardar miembros\n            int i = 0;\n            for (PlayerData pd : team.getMembersData()) {\n                String mPath = path + ".members." + i;\n                teamsConfig.set(mPath + ".uuid", pd.getUuid().toString());\n                teamsConfig.set(mPath + ".role", pd.getRole().name());\n                teamsConfig.set(mPath + ".kills", pd.getKills());\n                teamsConfig.set(mPath + ".deaths", pd.getDeaths());\n                i++;\n            }\n\n            // Guardar invites\n            int j = 0;\n            for (UUID invited : team.getInvites()) {\n                teamsConfig.set(path + ".invites." + j, invited.toString());\n                j++;\n            }\n        }\n        save();\n    }\n\n    // ========================\n    // Cargar equipos\n    // ========================\n    public Map<String, TeamData> loadTeams() {\n        Map<String, TeamData> loaded = new HashMap<>();\n        if (!teamsConfig.contains("teams")) return loaded;\n\n        for (String name : teamsConfig.getConfigurationSection("teams").getKeys(false)) {\n\n            // Home\n            Location home = null;\n            if (teamsConfig.contains("teams." + name + ".home")) {\n                String w = teamsConfig.getString("teams." + name + ".home.world");\n                double x = teamsConfig.getDouble("teams." + name + ".home.x");\n                double y = teamsConfig.getDouble("teams." + name + ".home.y");\n                double z = teamsConfig.getDouble("teams." + name + ".home.z");\n                home = new Location(plugin.getServer().getWorld(w), x, y, z);\n            }\n\n            // Lider\n            UUID leaderUuid = null;\n            if (teamsConfig.contains("teams." + name + ".leader")) {\n                leaderUuid = UUID.fromString(teamsConfig.getString("teams." + name + ".leader"));\n            } else {\n                // Si no hay líder definido, tomar primer miembro como líder\n                leaderUuid = UUID.randomUUID(); // temporal, se puede ajustar\n            }\n\n            TeamData team = new TeamData(name, leaderUuid);\n            team.setHome(home);\n\n            // Cargar miembros\n            if (teamsConfig.contains("teams." + name + ".members")) {\n                for (String key : teamsConfig.getConfigurationSection("teams." + name + ".members").getKeys(false)) {\n                    String mPath = "teams." + name + ".members." + key;\n                    UUID uuid = UUID.fromString(teamsConfig.getString(mPath + ".uuid"));\n                    if (uuid.equals(leaderUuid)) continue; // líder ya agregado en constructor\n\n                    PlayerData pd = new PlayerData(uuid);\n                    pd.setRole(PlayerData.Role.valueOf(teamsConfig.getString(mPath + ".role")));\n                    pd.setTeam(name);\n\n                    for (int k = 0; k < teamsConfig.getInt(mPath + ".kills"); k++) pd.addKill();\n                    for (int k = 0; k < teamsConfig.getInt(mPath + ".deaths"); k++) pd.addDeath();\n\n                    team.addMember(uuid); // usar método existente en TeamData\n                }\n            }\n\n            // Cargar invites\n            if (teamsConfig.contains("teams." + name + ".invites")) {\n                for (String key : teamsConfig.getConfigurationSection("teams." + name + ".invites").getKeys(false)) {\n                    UUID invited = UUID.fromString(teamsConfig.getString("teams." + name + ".invites." + key));\n                    team.addInvite(invited);\n                }\n            }\n\n            loaded.put(name, team);\n        }\n\n        return loaded;\n    }\n\n    // ========================\n    // Debug: imprimir equipos\n    // ========================\n    public void printTeams(Map<String, TeamData> teams) {\n        for (TeamData team : teams.values()) {\n            plugin.getLogger().info("Equipo: " + team.getName());\n            PlayerData leader = team.getLeader();\n            plugin.getLogger().info("  Lider: " + (leader != null ? leader.getUuid() : "Ninguno"));\n            plugin.getLogger().info("  Miembros:");\n            for (PlayerData pd : team.getMembersData()) {\n                plugin.getLogger().info("    - " + pd.getUuid() + " | Role: " + pd.getRole() +\n                        " | Kills: " + pd.getKills() + " | Deaths: " + pd.getDeaths());\n            }\n            plugin.getLogger().info("  Invites: " + team.getInvites());\n        }\n    }\n\n    // ========================\n    // Reiniciar archivo\n    // ========================\n    public void resetFile() {\n        teamsConfig.set("teams", null);\n        save();\n    }\n\n    // ========================\n    // Recuperar líder\n    // ========================\n    public PlayerData getTeamLeader(String teamName, Map<String, TeamData> teams) {\n        if (!teams.containsKey(teamName)) return null;\n        return teams.get(teamName).getLeader();\n    }\n\n    // ========================\n    // Verificar si jugador tiene invite\n    // ========================\n    public boolean isPlayerInvited(UUID uuid, Map<String, TeamData> teams) {\n        for (TeamData team : teams.values()) {\n            if (team.hasInvitePending(uuid)) return true;\n        }\n        return false;\n    }\n\n    // ========================\n    // Buscar equipo de un jugador\n    // ========================\n    public TeamData getPlayerTeam(UUID uuid, Map<String, TeamData> teams) {\n        for (TeamData team : teams.values()) {\n            if (team.hasMember(uuid)) return team;\n        }\n        return null;\n    }\n\n    // ========================\n    // Estadísticas globales\n    // ========================\n    public int getTotalKills(String teamName, Map<String, TeamData> teams) {\n        if (!teams.containsKey(teamName)) return 0;\n        return teams.get(teamName).getTotalKills();\n    }\n\n    public int getTotalDeaths(String teamName, Map<String, TeamData> teams) {\n        if (!teams.containsKey(teamName)) return 0;\n        return teams.get(teamName).getTotalDeaths();\n    }\n\n    public int getTeamPoints(String teamName, Map<String, TeamData> teams) {\n        if (!teams.containsKey(teamName)) return 0;\n        return teams.get(teamName).getPoints();\n    }\n\n    // ========================\n    // Métodos extendidos para futuro\n    // ========================\n    public List<PlayerData> getCoLeaders(String teamName, Map<String, TeamData> teams) {\n        if (!teams.containsKey(teamName)) return Collections.emptyList();\n        return teams.get(teamName).getCoLeaders();\n    }\n\n    public int getTotalMembers(String teamName, Map<String, TeamData> teams) {\n        if (!teams.containsKey(teamName)) return 0;\n        return teams.get(teamName).getTotalMembers();\n    }\n\n    public int getTotalCoLeaders(String teamName, Map<String, TeamData> teams) {\n        if (!teams.containsKey(teamName)) return 0;\n        return teams.get(teamName).getTotalCoLeaders();\n    }\n\n    public int getTotalLeaders(String teamName, Map<String, TeamData> teams) {\n        if (!teams.containsKey(teamName)) return 0;\n        return teams.get(teamName).getTotalLeaders();\n    }\n\n    // ========================\n    // Debug imprimir resumen\n    // ========================\n    public void debugTeamsSummary(Map<String, TeamData> teams) {\n        plugin.getLogger().info("=== Resumen de equipos ===");\n        for (TeamData team : teams.values()) {\n            plugin.getLogger().info("Equipo: " + team.getName() +\n                    " | Miembros: " + team.getTotalMembers() +\n                    " | Lider: " + (team.getLeader() != null ? team.getLeader().getUuid() : "Ninguno") +\n                    " | CoLeaders: " + team.getTotalCoLeaders());\n        }\n        plugin.getLogger().info("=== Fin resumen ===");\n    }\n\n}\nteam
